<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <NuGetAuditMode>direct</NuGetAuditMode>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BCrypt.Net-Core" Version="1.6.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
        <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
        <ProjectReference Include="..\OpenKoqis.Domain\OpenKoqis.Domain.csproj" />
        <ProjectReference Include="..\OpenKoqis.Application\OpenKoqis.Application.csproj" />
    </ItemGroup>

</Project>
